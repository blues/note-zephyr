{
	"name": "Zephyr Development Environment",

	// Pre-built from .devcontainer/Dockerfile by .github/workflows/devcontainer.yml.
	// It already contains the west workspace, so startup is a pull rather than a
	// full `west update`. To build it yourself instead, replace "image" with:
	//   "build": { "dockerfile": "Dockerfile", "context": ".." }
	"image": "ghcr.io/blues/note-zephyr-devcontainer:latest",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"ms-python.python",
				"ms-vscode.vscode-serial-monitor",
				"trond-snekvik.devicetree",
				"marus25.cortex-debug",
				"marus25.cortex-debug-dp-stm32l4"
			],
			"settings": {
				"devicetree.defaultBoard": "swan_r5"
			}
		}
	},

	"remoteUser": "root",

	"runArgs": [
		"--privileged" // You may wish to use mounts for binding USB devices instead. See https://code.visualstudio.com/remote/advancedcontainers/add-local-file-mount for /dev/bus/usb
	],

	"workspaceMount": "source=${localWorkspaceFolder},target=/workdir/note-zephyr,type=bind,consistency=cached",
	"workspaceFolder": "/workdir/note-zephyr",

	"onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/onCreateCommand.sh"
}
